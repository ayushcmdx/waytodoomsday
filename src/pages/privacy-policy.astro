---
import Layout from '../layouts/Layout.astro';

const lastUpdated = "August 3, 2026";

const sections = [
  {
    title: "Overview",
    body: "Way to Doomsday is an unofficial, non-commercial fan project built to track MCU releases before Avengers: Doomsday. It is not affiliated with, endorsed by, or connected to Marvel Studios or The Walt Disney Company. This page explains what information, if any, is collected when you use this site."
  }
];
---

<Layout title="Privacy Policy | Way to Doomsday">
  <main class="privacy-page">
    <div class="privacy-container">
      <header class="privacy-header">
        <h1>Privacy <span class="accent">Policy</span></h1>
        <p class="updated">Last updated: {lastUpdated}</p>
      </header>

      <section class="policy-section">
        <span class="section-number">01</span>
        <div class="section-body">
          <h2>Overview</h2>
          <p>
            Way to Doomsday is an unofficial, non-commercial fan project built to
            track MCU releases before Avengers: Doomsday. It is not affiliated
            with, endorsed by, or connected to Marvel Studios or The Walt Disney
            Company. This page explains what information, if any, is collected
            when you use this site.
          </p>
        </div>
      </section>

      <section class="policy-section">
        <span class="section-number">02</span>
        <div class="section-body">
          <h2>Information We Collect</h2>
          <p>
            This site does not require account creation and does not collect
            personal information such as your name, address, phone number, or
            payment details. We do not run any server-side database of user data.
            The following data points may exist only on your own device:
          </p>
          <ul class="clean-list">
            <li>
              <span class="dot"></span>
              <span><strong>Watch progress</strong> — which movies/series you've marked as watched, saved via your browser's local storage.</span>
            </li>
            <li>
              <span class="dot"></span>
              <span><strong>Display preferences</strong> — view mode (timeline/grid) and any theme or sort settings you choose.</span>
            </li>
            <li>
              <span class="dot"></span>
              <span><strong>Search input</strong> — text typed into the on-site search bar is processed client-side and never sent to or logged by a server.</span>
            </li>
          </ul>
          <p class="note">
            None of the above leaves your browser. If this site adds analytics
            (e.g. for aggregate page-view counts) in the future, this policy will
            be updated to disclose it before that change goes live.
          </p>
        </div>
      </section>

      <section class="policy-section">
        <span class="section-number">03</span>
        <div class="section-body">
          <h2>Cookies &amp; Local Storage</h2>
          <p>
            The site uses browser local storage only, not cookies, to remember
            your watch progress and display preferences. No third-party
            advertising or tracking cookies are used.
          </p>
        </div>
      </section>

      <section class="policy-section">
        <span class="section-number">04</span>
        <div class="section-body">
          <h2>Third-Party Content &amp; Video Clips</h2>
          <p>
            Movie posters, titles, and related media are used for identification
            and commentary purposes only, and remain the property of their
            respective copyright holders (Marvel Studios / Disney). Any preview
            clips hosted on this site are short, non-commercial excerpts served
            from our own storage infrastructure, used strictly for illustrative
            and watch-order tracking purposes.
          </p>
        </div>
      </section>

      <section class="policy-section">
        <span class="section-number">05</span>
        <div class="section-body">
          <h2>No Affiliation With Piracy or Illegal Streaming Sites</h2>
          <p>
            Way to Doomsday does not host, stream, download, or link to
            full-length copyrighted movies or series, and has no affiliation,
            partnership, or connection whatsoever with piracy or
            illegal-streaming websites — including but not limited to
            Vegamovies, HDHub4u, 7Movierulz, Katmoviehd, and similar platforms.
            This is purely a watch-order tracker and countdown site; it does not
            facilitate access to pirated content in any form, and any
            resemblance in name or branding to such sites is unintentional and
            disclaimed.
          </p>
        </div>
      </section>

      <section class="policy-section">
        <span class="section-number">06</span>
        <div class="section-body">
          <h2>Contact</h2>
          <p>
            If you have questions about this policy, reach out at
            <a href="mailto:ayushcmd@outlook.com">ayushcmd@outlook.com</a>.
          </p>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  .privacy-page {
    min-height: 60vh;
    background: #0a0a0a;
    padding: 4.5rem 1.5rem 5rem;
  }

  .privacy-container {
    max-width: 760px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.8);
  }

  .privacy-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  h1 {
    font-size: 2.1rem;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .accent {
    color: #e5231b;
  }

  .updated {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .policy-section {
    display: flex;
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .policy-section:last-child {
    border-bottom: none;
  }

  .section-number {
    flex-shrink: 0;
    font-size: 0.8rem;
    font-weight: 700;
    color: #e5231b;
    letter-spacing: 0.05em;
    padding-top: 0.15rem;
    width: 1.6rem;
  }

  .section-body {
    flex: 1;
    min-width: 0;
  }

  h2 {
    font-size: 1.05rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.7rem;
  }

  p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.65);
  }

  p.note {
    margin-top: 1rem;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.45);
  }

  .clean-list {
    list-style: none;
    margin: 1rem 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .clean-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.65);
  }

  .clean-list .dot {
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e5231b;
    margin-top: 0.55rem;
  }

  .clean-list strong {
    color: rgba(255, 255, 255, 0.9);
    font-weight: 600;
  }

  a {
    color: #e5231b;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  @media (max-width: 560px) {
    .policy-section {
      gap: 1rem;
    }
    .section-number {
      width: 1.3rem;
    }
  }
</style>